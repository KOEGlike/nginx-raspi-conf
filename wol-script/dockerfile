# Use a lightweight base image
FROM debian:bullseye-slim

# Install dependencies for building glibc
RUN apt-get update && apt-get install -y \
    wget build-essential manpages-dev \
    && apt-get clean

# Download and build glibc 2.34
RUN wget http://ftp.gnu.org/gnu/libc/glibc-2.34.tar.gz && \
    tar -xvzf glibc-2.34.tar.gz && \
    cd glibc-2.34 && \
    mkdir build && cd build && \
    ../configure --prefix=/opt/glibc-2.34 && \
    make -j$(nproc) && make install && \
    cd / && rm -rf glibc-2.34 glibc-2.34.tar.gz

# Update the library path
ENV LD_LIBRARY_PATH=/opt/glibc-2.34/lib:$LD_LIBRARY_PATH

# Copy the wol-script binary into the container
COPY ./wol-script /usr/local/bin/wol-script

# Copy the environment file (optional, if needed by the script)
COPY .env.example /usr/local/bin/.env

# Set the entrypoint to the wol-script
ENTRYPOINT ["/usr/local/bin/wol-script"]